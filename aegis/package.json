{
  "name": "aegis-advanced-runtime",
  "version": "18.4.3-active-body-experimental",
  "private": true,
  "scripts": {
    "build": "node tools/build-advanced.cjs",
    "test": "node tools/advanced-tests/runtime.cjs && node tools/advanced-tests/continuation.cjs && node tools/advanced-tests/contact-rig.cjs && node tools/advanced-tests/traction.cjs && node tools/advanced-tests/trace-bvh.cjs && node tools/advanced-tests/navigation.cjs && node tools/advanced-tests/brass.cjs && node tools/advanced-tests/active-body.cjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "node tools/advanced-tests/browser-smoke.cjs",
    "test:models": "node tools/advanced-tests/continuation-browser.cjs",
    "test:medical": "node tools/advanced-tests/medical-browser.cjs",
    "test:quality": "node tools/advanced-tests/quality-v3-browser.cjs",
    "test:soak": "node tools/advanced-tests/soak-browser.cjs",
    "test:aim": "node tools/advanced-tests/combat-aim-browser.cjs",
    "test:render": "node tools/advanced-tests/render-browser.cjs",
    "test:navigation": "node tools/advanced-tests/navigation-browser.cjs",
    "test:elevated": "ELEVATED=1 node tools/advanced-tests/medical-browser.cjs",
    "test:brass": "node tools/advanced-tests/brass-browser.cjs",
    "test:active-body": "node tools/advanced-tests/active-body.cjs",
    "test:active-body:acceptance": "node tools/advanced-tests/active-body-acceptance.cjs",
    "test:active-body:browser": "node tools/advanced-tests/active-body-browser.cjs",
    "test:active-body:motors": "node tools/advanced-tests/active-body-motors.cjs",
    "test:active-body:contacts": "node tools/advanced-tests/active-body-contacts.cjs",
    "test:active-body:performance": "node tools/advanced-tests/active-body-performance.cjs",
    "test:active-body:robustness": "node tools/advanced-tests/active-body-robustness.cjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
